<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A separate package, so the Shield360 package never pulls in Entity Framework Core. -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Shield360.EntityFrameworkCore</RootNamespace>
    <AssemblyName>Shield360.EntityFrameworkCore</AssemblyName>
    <!-- The same version as Shield360: <Version> in Shield360.csproj stays the only place it is set. -->
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../Shield360/Shield360.csproj')), '&lt;Version&gt;([^&lt;]+)&lt;/Version&gt;').Groups[1].Value)</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>

    <PackageId>Shield360.EntityFrameworkCore</PackageId>
    <Title>Shield360 for Entity Framework Core</Title>
    <Authors>ThinkfleetAI</Authors>
    <Company>ThinkfleetAI</Company>
    <Product>Shield360</Product>
    <Description>An Entity Framework Core command interceptor for Shield360 runtime application self-protection (RASP): checks the SQL of every command for injection from request input or model output before it is executed.</Description>
    <PackageTags>shield360;rasp;entityframeworkcore;efcore;sql-injection;security;runtime-protection</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Shield360-AI/shield360-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Shield360-AI/shield360-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- The lowest supported EF Core major; apps on a later EF Core get theirs. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.32" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Shield360/Shield360.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shield360.Tests" />
  </ItemGroup>

</Project>
