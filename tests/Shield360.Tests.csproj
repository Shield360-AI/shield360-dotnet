<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Shield360.Tests</RootNamespace>
    <!-- Tests name things freely and call experimental library APIs. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2254;CA1707;CA1515;CA1849;CA2007;CA2000;CA1861;CA1859;OPENAI001;SKEXP0001;SKEXP0010;MEAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" Version="1.19.1" />
    <!-- Runs the RASP middleware in a real ASP.NET Core pipeline. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="9.0.20" />
    <!-- The RASP sink hooks against the real libraries: SqlClient's diagnostic events, EF Core's interceptors. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <PackageReference Include="MongoDB.Driver" Version="3.13.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.85.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.32" />

    <!-- The real libraries, to check the source names Shield360 listens to. -->
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageReference Include="Azure.AI.Inference" Version="1.0.0-beta.5" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.81.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../src/Shield360/Shield360.csproj" />
    <ProjectReference Include="../src/Shield360.AspNetCore/Shield360.AspNetCore.csproj" />
    <ProjectReference Include="../src/Shield360.EntityFrameworkCore/Shield360.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <!-- Zero-code tests: built first, started as child processes, never referenced. -->
  <ItemGroup>
    <Compile Remove="ZeroCodeApps/**" />
    <None Remove="ZeroCodeApps/**" />
    <Content Remove="ZeroCodeApps/**" />
    <ProjectReference Include="../src/Shield360.StartupHook/Shield360.StartupHook.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="ZeroCodeApps/ZeroCodeConsole/ZeroCodeConsole.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="ZeroCodeApps/ZeroCodeWeb/ZeroCodeWeb.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

</Project>
